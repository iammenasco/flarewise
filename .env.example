# Public GitHub repo used for "Edit on GitHub" + issue submission links.
VITE_GITHUB_OWNER=iammenasco
VITE_GITHUB_REPO=flarewise

# Production custom domain is a hostname root (https://flarewise.menas.co),
# so the deploy workflow builds with VITE_BASE=/. Local preview defaults to /
# via vite.config when unset.
VITE_BASE=/
